# ========================================================
# Theater QR Order Platform - Environment Configuration
# ========================================================

# Backend API
PORT=5000
MONGODB_URI=mongodb://localhost:27017/theater-qr-order
JWT_SECRET=super_secret_jwt_token_change_in_production_99812

# Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Frontend Application URL (Customer, Counter Staff & Admin)
FRONTEND_URL=http://localhost:5173

# Kitchen Thermal Receipt Printer (Print Agent)
PRINTER_IP=192.168.1.100
PRINTER_PORT=9100
POLL_INTERVAL=4000
THEATER_ID=demo-theater

# Admin Automated Voice Calling & Escalation (Twilio Voice API)
ADMIN_PHONE=7092466027
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX


